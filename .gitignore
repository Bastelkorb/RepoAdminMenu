<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <RootNamespace>RepoAdminMenu</RootNamespace>
    <AssemblyName>RepoAdminMenu</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('REPO_GAME_ROOT'))</GameRoot>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$([System.Environment]::GetEnvironmentVariable('BEPINEX_DIR'))</BepInExDir>
    <ModLibDir Condition="'$(ModLibDir)' == ''">$([System.Environment]::GetEnvironmentVariable('REPO_MOD_LIBS_DIR'))</ModLibDir>
  </PropertyGroup>

  <Target Name="ValidateLocalDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameRoot)' == '' Or !Exists('$(GameRoot)')" Text="GameRoot not found. Set REPO_GAME_ROOT or pass -p:GameRoot=." />
    <Error Condition="'$(BepInExDir)' == '' Or !Exists('$(BepInExDir)')" Text="BepInEx directory not found. Set BEPINEX_DIR or pass -p:BepInExDir=." />
    <Error Condition="'$(ModLibDir)' == '' Or !Exists('$(ModLibDir)')" Text="Mod library directory not found. Set REPO_MOD_LIBS_DIR or pass -p:ModLibDir=." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameRoot)\R.E.P.O_Data\Managed\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MenuLib">
      <HintPath>$(ModLibDir)\MenuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="REPOLib">
      <HintPath>$(ModLibDir)\REPOLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>
</Project>
